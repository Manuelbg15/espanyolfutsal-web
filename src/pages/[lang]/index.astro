---
import Layout from "../../layouts/Layout.astro";
import { patrocinadors, mitjans } from "../../data/sponsors";
import SectionCard from "../../components/SectionCard.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang as any);

// Load news from Astro local collection
let latestNews: any[] = [];
try {
  const collectionPosts = await getCollection("actualitat");
  latestNews = collectionPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3)
    .map((post) => ({
      id: post.slug,
      title: post.data.title,
      description: post.data.description,
      imageUrl: post.data.heroImage || "/images/equips/1r-equip-masculi.jpg",
    }));
} catch (e) {
  latestNews = [];
}

const sections = [
  {
    title: t("home.sections.federat.title"),
    image: "/images/equips/1r-equip-masculi.jpg",
    link: `/${lang}/seccions/futbol-sala`,
    description: t("home.sections.federat.desc"),
  },
  {
    title: t("home.sections.escolar.title"),
    image: "/images/activitats/escolar.jpg",
    link: `/${lang}/extraescolars`,
    description: t("home.sections.escolar.desc"),
  },
  {
    title: t("home.sections.campus.title"),
    image: "/images/activitats/campus.jpg",
    link: `/${lang}/campus-esportius`,
    description: t("home.sections.campus.desc"),
  },
];

---

<Layout title="SD Espanyol Futbol Sala | Pàgina Oficial">
  <!-- HERO PRINCIPAL -->
  <section
    class="relative min-h-[85vh] flex items-center justify-center overflow-hidden py-24"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/equips/1r-equip-masculi.jpg"
        alt="SD Espanyol Futbol Sala"
        class="w-full h-full object-cover animate-slow-zoom"
      />
      <!-- Rich Blue & Navy Blanquiblau Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#07224f]/95 via-[#005bac]/85 to-[#07224f]/90"></div>
    </div>

    <div
      class="relative z-10 text-center px-4 max-w-5xl mx-auto flex flex-col items-center"
    >
      <!-- Escudo Oficial -->
      <div class="mb-6 transform hover:scale-105 transition-transform" data-aos="zoom-in">
        <img
          src="/images/escudo-espanyol.png"
          alt="Escut SD Espanyol Futbol Sala"
          class="h-28 md:h-36 w-auto drop-shadow-2xl mx-auto"
        />
      </div>

      <div class="inline-block bg-white/10 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/20 mb-6" data-aos="fade-down">
        <span class="text-white text-xs md:text-sm font-bold tracking-widest uppercase">
          Temporada 2026-27 • Seccions Esportives Espanyol
        </span>
      </div>

      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6 leading-tight tracking-tight drop-shadow-lg uppercase font-heading"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        {t("home.hero.title_part1")}
        <span class="text-[#00a3e0] block md:inline">{t("home.hero.title_part2")}</span>
      </h1>

      <p
        class="text-lg md:text-2xl text-blue-100 font-medium italic mb-10 max-w-3xl leading-relaxed text-shadow-sm"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        {t("home.hero.subtitle")}
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <a
          href={`/${lang}/inscripcions-2026-27`}
          class="inline-block px-8 py-4 bg-[#0073ce] hover:bg-[#005bac] text-white rounded-xl font-extrabold text-base md:text-lg shadow-xl hover:scale-105 transition-all text-center tracking-wide"
        >
          {t("home.hero.cta_join")}
        </a>
        <a
          href={`/${lang}/simpatitzant`}
          class="inline-block px-8 py-4 bg-white text-[#0073ce] hover:bg-blue-50 rounded-xl font-extrabold text-base md:text-lg shadow-xl hover:scale-105 transition-all text-center tracking-wide"
        >
          💙 {t("nav.simpatitzant")}
        </a>
        <a
          href={`/${lang}/el-club`}
          class="px-8 py-4 bg-white/10 hover:bg-white/20 border-2 border-white/40 text-white rounded-xl font-bold text-base md:text-lg transition-all text-center backdrop-blur-sm"
        >
          {t("home.hero.cta_project")}
        </a>
      </div>
    </div>
  </section>

  <!-- BANNER VALORS & IDENTITAT -->
  <section class="py-12 bg-white border-b border-gray-100 shadow-sm relative z-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-gray-100">
        <div class="p-4" data-aos="fade-up" data-aos-delay="100">
          <p class="text-3xl md:text-4xl font-extrabold text-[#0073ce] font-heading">2017</p>
          <p class="text-xs md:text-sm font-semibold text-gray-600 mt-1 uppercase">Seccions Esportives</p>
        </div>
        <div class="p-4" data-aos="fade-up" data-aos-delay="200">
          <p class="text-3xl md:text-4xl font-extrabold text-[#0073ce] font-heading">2022</p>
          <p class="text-xs md:text-sm font-semibold text-gray-600 mt-1 uppercase">Retorn Futbol Sala</p>
        </div>
        <div class="p-4" data-aos="fade-up" data-aos-delay="300">
          <p class="text-3xl md:text-4xl font-extrabold text-[#0073ce] font-heading">10+</p>
          <p class="text-xs md:text-sm font-semibold text-gray-600 mt-1 uppercase">Equips Federats</p>
        </div>
        <div class="p-4" data-aos="fade-up" data-aos-delay="400">
          <p class="text-3xl md:text-4xl font-extrabold text-[#0073ce] font-heading">100%</p>
          <p class="text-xs md:text-sm font-semibold text-gray-600 mt-1 uppercase">Sentiment Perico</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BARCELONA FUTSAL CUP -->
  <section id="barcelona-futsal-cup" class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <div class="lg:w-1/2 order-2 lg:order-1" data-aos="fade-right">
          <h2 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6 font-heading">
            {t("home.cup.title")}
          </h2>
          <div class="w-24 h-1 bg-[#0073ce] mb-8 rounded-full"></div>
          <p class="text-xl text-gray-700 mb-10 leading-relaxed font-light">
            {t("home.cup.desc")}
          </p>
          <a
            href="https://barcelonafutsalcup.es/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-4 bg-[#0073ce] hover:bg-[#005bac] text-white rounded-lg font-bold text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all"
          >
            {t("home.cup.cta")} 🏆
          </a>
        </div>
        <div class="lg:w-1/2 order-1 lg:order-2" data-aos="zoom-in">
          <a
            href="https://barcelonafutsalcup.es/"
            target="_blank"
            rel="noopener noreferrer"
            class="block relative rounded-xl overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img src="/images/barcelona-futsal-cup.jpg" alt="Barcelona Futsal Cup" loading="lazy" class="w-full h-auto object-cover" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIONS I ACTIVITATS -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-[#0073ce] font-bold text-sm uppercase tracking-widest block mb-2">Descobreix el nostre club</span>
        <h2
          class="text-3xl md:text-4xl font-extrabold text-gray-900 uppercase tracking-tight font-heading"
        >
          {t("home.sections.title")}
        </h2>
        <div class="w-20 h-1.5 bg-[#0073ce] mx-auto mt-4 rounded-full"></div>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          {t("home.sections.subtitle")}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          sections.map((section, index) => (
            <div data-aos="fade-up" data-aos-delay={index * 100}>
              <SectionCard
                title={section.title}
                image={section.image}
                link={section.link}
                description={section.description}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DESTACAT: FES-TE SIMPATITZANT -->
  <section
    class="py-24 relative overflow-hidden text-white"
    style="background: linear-gradient(135deg, #07224f 0%, #005bac 50%, #0073ce 100%);"
  >
    <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-6">
        <span>🧣</span> Membresia Oficial 2026-27
      </div>

      <h2
        class="text-3xl md:text-5xl font-extrabold mb-4 uppercase font-heading text-shadow-sm"
      >
        {t("simpatitzant.title")}
      </h2>
      <p class="text-lg md:text-xl text-blue-100 mb-10 max-w-2xl mx-auto leading-relaxed">
        {t("simpatitzant.subtitle")}
      </p>

      <div
        class="bg-white/10 backdrop-blur-md rounded-2xl p-8 mb-10 text-left md:w-4/5 mx-auto border border-white/20 shadow-xl"
      >
        <ul class="space-y-4 text-base md:text-lg">
          <li class="flex items-start">
            <span class="mr-3 text-2xl">🧣</span>
            <span>{t("simpatitzant.benefit1")}</span>
          </li>
          <li class="flex items-start">
            <span class="mr-3 text-2xl">📺</span>
            <span>{t("simpatitzant.benefit2")}</span>
          </li>
          <li class="flex items-start">
            <span class="mr-3 text-2xl">🏷️</span>
            <span>{t("simpatitzant.benefit3")}</span>
          </li>
          <li class="flex items-start">
            <span class="mr-3 text-2xl">🎉</span>
            <span>{t("simpatitzant.benefit4")}</span>
          </li>
        </ul>
      </div>

      <div class="text-lg md:text-xl font-medium mb-10 space-y-2">
        <p>
          {t("simpatitzant.price_prefix")}
          <span class="font-extrabold text-4xl text-white ml-2 mr-1"
            >{t("simpatitzant.price_val")}</span
          >
          {t("simpatitzant.price_suffix")}
        </p>
        <p class="text-blue-100 text-sm">
          {t("simpatitzant.welcome")} • {t("simpatitzant.thanks")}
        </p>
      </div>

      <a
        href={`/${lang}/simpatitzant`}
        class="inline-block px-10 py-5 bg-white text-[#0073ce] hover:bg-blue-50 rounded-xl font-extrabold text-lg md:text-xl shadow-2xl transition-all transform hover:-translate-y-1"
      >
        {t("simpatitzant.cta")}
      </a>
    </div>
  </section>

  <!-- INSTAL·LACIONS RESUM -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-[#0073ce] font-bold text-sm uppercase tracking-widest block mb-2">On juguem</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 uppercase font-heading">
          {t("club.facilities.title")}
        </h2>
        <div class="w-20 h-1.5 bg-[#0073ce] mx-auto mt-4 rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- Pavello 1 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100" data-aos="fade-right">
          <div class="aspect-video w-full overflow-hidden">
            <img
              src="/images/instalacions/pavello-jm-1.jpg"
              alt="Club Esportiu JM Sant Gervasi"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-2 font-heading">
              Club Esportiu JM Sant Gervasi
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              📍 Carrer de Jesús i Maria, 25, Sarrià-Sant Gervasi, 08022 Barcelona
            </p>
            <p class="text-gray-700 text-sm leading-relaxed mb-6">
              Pabelló cobert amb pista 1 (blau), pista 2 (arriba) i pista annexa per a entrenaments i partits de competició.
            </p>
            <a href={`/${lang}/el-club#instal-lacions`} class="text-[#0073ce] font-bold text-sm hover:underline inline-flex items-center gap-1">
              Veure totes les fotos →
            </a>
          </div>
        </div>

        <!-- Pavello 2 -->
        <div class="bg-slate-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100" data-aos="fade-left">
          <div class="aspect-video w-full overflow-hidden">
            <img
              src="/images/instalacions/pavello-xaloc-1.jpg"
              alt="Pavelló Col·legi Xaloc"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-2 font-heading">
              Pavelló Col·legi Xaloc
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              📍 Avinguda de la Granvia de l'Hospitalet, 102, 08902 L'Hospitalet de Llobregat, Barcelona
            </p>
            <p class="text-gray-700 text-sm leading-relaxed mb-6">
              Instal·lació adaptada per al màxim rendiment amb pavelló cobert i graderies per als nostres aficionats.
            </p>
            <a href={`/${lang}/el-club#instal-lacions`} class="text-[#0073ce] font-bold text-sm hover:underline inline-flex items-center gap-1">
              Veure totes les fotos →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PATROCINADORS I MITJANS -->
  <section class="py-20 bg-slate-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 uppercase font-heading">
          {t("club.sponsors.title")} & {t("club.media.title")}
        </h2>
        <div class="w-16 h-1 bg-[#0073ce] mx-auto mt-3 rounded-full"></div>
      </div>

      <!-- Patrocinadors Cards -->
      <div class="mb-10">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest text-center mb-6">
          {t("club.sponsors.title")}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {
            patrocinadors.map((p) => (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                title={`${p.name} · ${p.desc}`}
                class="bg-white p-5 h-32 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-[#0073ce] transition-all text-center flex flex-col justify-center items-center group"
              >
                <img src={p.img} alt={p.name} loading="lazy" class="h-20 w-full object-contain group-hover:scale-105 transition-transform" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Mitjans Cards -->
      <div>
        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest text-center mb-6">
          {t("club.media.title")}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {
            mitjans.map((m) => (
              <a
                href={m.url}
                target="_blank"
                rel="noopener noreferrer"
                title={`${m.name} · ${m.desc}`}
                class="bg-white p-4 h-32 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-[#0073ce] transition-all text-center flex flex-col justify-center items-center group"
              >
                <img src={m.img} alt={m.name} loading="lazy" class="h-20 w-full object-contain group-hover:scale-105 transition-transform" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ÚLTIMA ACTUALITAT -->
  {latestNews.length > 0 && (
    <section class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-extrabold text-gray-900 uppercase font-heading">
            {t("news.latest.title")}
          </h2>
          <div class="w-16 h-1 bg-[#0073ce] mx-auto mt-3 rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          {
            latestNews.map((item, index) => (
              <div data-aos="fade-up" data-aos-delay={index * 100}>
                <NewsCard
                  title={item.title}
                  image={item.imageUrl}
                  link={`/${lang}/actualitat/${item.id}`}
                  excerpt={item.description || ""}
                />
              </div>
            ))
          }
        </div>

        <div class="text-center">
          <a
            href={`/${lang}/actualitat`}
            class="inline-block px-8 py-3.5 border-2 border-[#0073ce] text-[#0073ce] hover:bg-[#0073ce] hover:text-white rounded-xl font-bold uppercase tracking-wider transition-colors text-sm"
          >
            {t("news.read_more")}
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- BANNER FINAL CTA -->
  <section class="py-16 bg-[#07224f] text-white text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 uppercase font-heading">
        {t("cta.play_full")}
      </h2>
      <p class="text-blue-200 text-lg mb-8 leading-relaxed">
        {t("inscription.card.desc")}
      </p>
      <a
        href={`/${lang}/inscripcions-2026-27`}
        class="inline-block px-10 py-4 bg-[#0073ce] hover:bg-[#005bac] text-white font-extrabold text-lg rounded-xl shadow-xl hover:scale-105 transition-all"
      >
        SOL·LICITA INFORMACIÓ ⚽
      </a>
    </div>
  </section>
</Layout>
