---
import Layout from "../../layouts/Layout.astro";
import SectionCard from "../../components/SectionCard.astro";
import NewsCard from "../../components/NewsCard.astro";

import { getCollection } from "astro:content";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang as any);

let latestNews: any[] = [];
try {
  const response = await fetch("https://cms.dragonrcnc.com/api/noticias", {
    method: "GET",
    headers: {
      "X-API-KEY": import.meta.env.CMS_API_KEY || process.env.CMS_API_KEY || "",
      Origin: import.meta.env.PROD
        ? "https://clubesportiuacademia.es"
        : "http://localhost:4321",
      Accept: "application/json",
    },
  });

  if (response.ok) {
    const data = await response.json();
    latestNews = data
      .map((post: any) => ({
        ...post,
        imageUrl: post.imageUrl
          ? `https://cms.dragonrcnc.com${post.imageUrl}`
          : "/images/logo-projecte.png",
      }))
      .slice(0, 3);
  }
} catch (error) {
  console.error("Error fetching news for home:", error);
}

// Data from WP
const sections = [
  {
    title: t("home.sections.project.title"),
    image: "/images/logo-projecte.png",
    link: `/${lang}/el-club`,
    description: t("home.sections.project.desc"),
  },
  {
    title: t("home.sections.federated.title"),
    image: "/images/card-federats.svg",
    link: `/${lang}/seccions`,
    description: t("home.sections.federated.desc"),
  },
  {
    title: t("home.sections.campus.title"),
    image: "/images/card-campus.svg",
    link: `/${lang}/campus-esportius`,
    description: t("home.sections.campus.desc"),
  },
  {
    title: t("home.sections.extra.title"),
    image: "/images/card-extraescolars.svg",
    link: `/${lang}/extraescolars`,
    description: t("home.sections.extra.desc"),
  },
];
---

<Layout title="Club Esportiu Acadèmia | Inici">
  <!-- HERO WP-COVER -->
  <section
    class="relative h-[85vh] min-h-[600px] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-bg.jpg"
        alt="Jugador de fútbol sala"
        class="w-full h-full object-cover animate-slow-zoom"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <div
      class="relative z-10 text-center px-4 max-w-5xl mx-auto flex flex-col items-center"
    >
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white mb-10 leading-tight tracking-tight drop-shadow-lg uppercase font-heading"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        {t("home.hero.title_part1")}
        <span class="text-club-gold">{t("home.hero.title_part2")}</span>
      </h1>

      <div
        class="flex flex-col sm:flex-row gap-6 w-full sm:w-auto"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <a
          href={`/${lang}/inscripcions-2026-27`}
          class="inline-block px-8 py-4 bg-club-granate text-white rounded-lg font-bold hover:bg-club-granate/90 hover:scale-105 transition-all shadow-lg text-lg"
        >
          {t("home.hero.cta_join")}
        </a>
        <a
          href={`/${lang}/el-club#projecte`}
          class="px-8 py-4 bg-transparent border-2 border-white text-white rounded-lg font-bold text-lg md:text-xl hover:bg-white hover:text-gray-900 transition-all text-center"
        >
          {t("home.hero.cta_project")}
        </a>
      </div>
    </div>
  </section>

  <!-- BARCELONA FUTSAL CUP -->
  <section class="py-24 bg-slate-50 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <div class="lg:w-1/2 order-2 lg:order-1" data-aos="fade-right">
          <h2
            id="barcelona-futsal-cup-2027"
            class="text-3xl md:text-5xl font-bold text-gray-900 mb-6 font-heading"
          >
            {t("home.futsal_cup.title")}
          </h2>
          <div class="w-24 h-1 bg-club-gold mb-8 rounded-full"></div>
          <p class="text-xl text-gray-700 mb-10 leading-relaxed font-light">
            {t("home.futsal_cup.description")}
          </p>

          <a
            href="https://barcelonafutsalcup.es/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-4 bg-club-granate text-white rounded-lg font-bold text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all"
          >
            {t("home.futsal_cup.cta")}
          </a>
        </div>

        <div class="lg:w-1/2 order-1 lg:order-2" data-aos="zoom-in">
          <div
            class="relative rounded-xl overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img
              src="/images/futsal-cup-2026.jpg"
              alt="Barcelona Futsal Cup"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIONS I ACTIVITATS -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-gray-900 uppercase tracking-wide font-heading"
        >
          {t("home.sections.title")}
        </h2>
        <div class="w-20 h-1 bg-club-granate mx-auto mt-4 rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        {
          sections.map((section, index) => (
            <div data-aos="fade-up" data-aos-delay={index * 100}>
              <SectionCard
                title={section.title}
                image={section.image}
                link={section.link}
                description={section.description}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SIMPATITZANT GRADIENT -->
  <section
    class="py-24 relative overflow-hidden text-white"
    style="background: linear-gradient(35deg, rgba(140, 102, 54, 1) 0%, rgba(243, 175, 103, 1) 100%);"
  >
    <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
      <h2
        class="text-3xl md:text-5xl font-bold mb-8 uppercase font-heading text-shadow-sm"
      >
        <span
          set:html={t("home.sympathizer.title").replace(
            "Club Esportiu Acadèmia Barcelona",
            "Club Esportiu Acadèmia Barcelona <br/>",
          )}
        />
      </h2>

      <p
        class="text-xl mb-10 font-medium bg-black/10 inline-block px-4 py-2 rounded-lg backdrop-blur-sm"
      >
        {t("home.sympathizer.intro")}
      </p>

      <div
        class="bg-white/10 backdrop-blur-md rounded-2xl p-8 mb-10 text-left md:w-3/4 mx-auto border border-white/20 shadow-inner"
      >
        <ul class="space-y-4 text-lg">
          <li class="flex items-start">
            <span class="mr-3 text-2xl">🧣</span>
            <span>{t("home.sympathizer.benefit1")}</span>
          </li>
          <li class="flex items-start">
            <span class="mr-3 text-2xl">📺</span>
            <span>{t("home.sympathizer.benefit2")}</span>
          </li>
          <li class="flex items-start">
            <span class="mr-3 text-2xl">🏷️</span>
            <span>{t("home.sympathizer.benefit3")}</span>
          </li>
          <li class="flex items-start">
            <span class="mr-3 text-2xl">🎉</span>
            <span>{t("home.sympathizer.benefit4")}</span>
          </li>
        </ul>
      </div>

      <div class="text-lg md:text-xl font-medium mb-12 space-y-2">
        <p>
          {t("home.sympathizer.price_prefix")}
          <span class="font-bold text-3xl"
            >{t("home.sympathizer.price_val")}</span
          >
          {t("home.sympathizer.price_suffix")}
        </p>
        <p class="text-white/80 text-base">
          {t("home.sympathizer.payment")}
        </p>
      </div>

      <a
        href={`/${lang}/`}
        class="inline-block px-10 py-5 bg-club-granate hover:bg-white hover:text-club-granate text-white rounded-lg font-bold text-xl shadow-xl transition-all transform hover:-translate-y-1"
      >
        {t("home.sympathizer.cta")}
      </a>
    </div>
  </section>

  <!-- ÚLTIMA ACTUALITAT -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-gray-900 uppercase font-heading"
        >
          {t("home.news.title")}
        </h2>
        <p class="text-xl text-gray-600 mt-4">
          {t("home.news.subtitle")}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {
          latestNews.map((item, index) => (
            <div data-aos="fade-up" data-aos-delay={index * 100}>
              <NewsCard
                title={item.title}
                image={item.imageUrl}
                link={`/${lang}/actualitat/${item.id}`}
                excerpt={item.description || ""}
              />
            </div>
          ))
        }
      </div>

      <div class="text-center">
        <a
          href={`/${lang}/actualitat`}
          class="inline-block px-8 py-3 border-2 border-gray-800 text-gray-800 rounded-lg font-bold hover:bg-gray-800 hover:text-white transition-all uppercase tracking-wider"
        >
          {t("home.news.cta")}
        </a>
      </div>
    </div>
  </section>
</Layout>
