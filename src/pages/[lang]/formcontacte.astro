---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const field =
  "w-full px-4 py-3 rounded-lg border border-gray-300 bg-white focus:border-[#0073ce] focus:ring-2 focus:ring-[#0073ce]/20 outline-none transition";
const label = "block text-sm font-bold text-gray-700 mb-1.5";
const subjects = [
  t("contact.form.subject.info"),
  t("contact.form.subject.inscription"),
  t("contact.form.subject.simpatitzant"),
  t("contact.form.subject.campus"),
  t("contact.form.subject.store"),
  t("contact.form.subject.other"),
];
---

<Layout title={`${t("contact.hero.title")} | SD Espanyol Futbol Sala`}>
  <section class="relative h-[38vh] min-h-[320px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/images/instalacions/pavello-jm-2.jpg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#07224f]/95 via-[#005bac]/85 to-[#07224f]/95"></div>
    </div>
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4 uppercase font-heading tracking-tight">
        {t("contact.hero.title")}
      </h1>
      <p class="text-lg text-blue-100">{t("contact.hero.subtitle")}</p>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-3 gap-10 items-start">
      <!-- Formulari -->
      <form
        id="contactForm"
        class="lg:col-span-2 bg-white rounded-2xl border border-gray-200 border-t-4 border-t-[#0073ce] shadow-lg p-6 md:p-10 space-y-5"
        data-sending={t("contact.form.btn.sending")}
        data-submit={t("contact.form.btn.submit")}
        data-ok={t("contact.form.success")}
        data-error={t("contact.form.error")}
      >
        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <label class={label} for="c-name">{t("contact.form.name")}</label>
            <input id="c-name" name="name" type="text" required autocomplete="given-name" placeholder={t("contact.form.name.placeholder")} class={field} />
          </div>
          <div>
            <label class={label} for="c-surname">{t("contact.form.surname")}</label>
            <input id="c-surname" name="surname" type="text" required autocomplete="family-name" placeholder={t("contact.form.surname.placeholder")} class={field} />
          </div>
        </div>
        <div>
          <label class={label} for="c-email">{t("contact.form.email")}</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" placeholder={t("contact.form.email.placeholder")} class={field} />
        </div>
        <div>
          <label class={label} for="c-subject">{t("contact.form.subject")}</label>
          <select id="c-subject" name="subject" required class={field}>
            <option value="">{t("contact.form.subject.default")}</option>
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div>
          <label class={label} for="c-message">{t("contact.form.message")}</label>
          <textarea id="c-message" name="message" rows="6" required placeholder={t("contact.form.message.placeholder")} class={field}></textarea>
        </div>

        <!-- Anti-spam: camp ocult -->
        <div class="hidden" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="flex items-start gap-3">
          <input id="c-privacy" name="privacy" type="checkbox" required class="mt-1 w-5 h-5 accent-[#0073ce]" />
          <label for="c-privacy" class="text-sm text-gray-600" set:html={t("contact.form.privacy")} />
        </div>

        <button
          id="submitBtn"
          type="submit"
          class="w-full md:w-auto px-8 py-4 bg-[#0073ce] hover:bg-[#005696] disabled:opacity-60 text-white font-extrabold rounded-xl transition-colors"
        >
          {t("contact.form.btn.submit")}
        </button>
        <div id="formStatus" class="hidden" role="status" aria-live="polite"></div>
      </form>

      <!-- Dades de contacte -->
      <aside class="bg-[#07224f] text-white rounded-2xl p-8 space-y-6">
        <div>
          <h2 class="text-xl font-bold font-heading mb-2">SD Espanyol Futbol Sala</h2>
          <p class="text-blue-100 text-sm leading-relaxed">
            Carrer Pau Claris, 176, 1r 1a<br />08037 Barcelona
          </p>
        </div>
        <div class="space-y-2 text-sm">
          <a href="tel:+34640066023" class="block hover:text-[#00a3e0]">📞 +34 640 066 023</a>
          <a href="mailto:info@espanyolfutsal.es" class="block hover:text-[#00a3e0]">✉️ info@espanyolfutsal.es</a>
        </div>
        <div class="space-y-2 text-sm border-t border-white/15 pt-6">
          <a href="https://www.instagram.com/sdespanyol_futsal" target="_blank" rel="noopener noreferrer" class="block hover:text-[#00a3e0]">Instagram · @sdespanyol_futsal</a>
          <a href="https://www.youtube.com/@SDEspanyolFutsal" target="_blank" rel="noopener noreferrer" class="block hover:text-[#00a3e0]">YouTube · @SDEspanyolFutsal</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  const btn = document.getElementById("submitBtn") as HTMLButtonElement | null;
  const status = document.getElementById("formStatus");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!btn || !status) return;
    btn.disabled = true;
    btn.textContent = form.dataset.sending || "...";
    status.className = "hidden";
    try {
      const res = await fetch("/send-mail.php", { method: "POST", body: new FormData(form) });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json.status !== "success") throw new Error(json.message);
      status.textContent = form.dataset.ok || "OK";
      status.className = "bg-green-50 text-green-800 border border-green-200 p-4 rounded-lg font-medium";
      form.reset();
    } catch {
      status.textContent = form.dataset.error || "Error";
      status.className = "bg-red-50 text-red-800 border border-red-200 p-4 rounded-lg font-medium";
    } finally {
      btn.disabled = false;
      btn.textContent = form.dataset.submit || "Enviar";
    }
  });
</script>
