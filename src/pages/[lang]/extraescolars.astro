---
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang as any);
---

<Layout title={`Extraescolars | Club Esportiu Acadèmia`}>
  <!-- Hero Section -->
  <section
    class="relative h-[50vh] min-h-[450px] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/extraescolars-hero.png"
        alt="Extraescolars Hero"
        class="w-full h-full object-cover"
      />
      <!-- OVERLAY: #734c40 with opacity -->
      <div class="absolute inset-0 bg-[#734c40]/70"></div>
    </div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1
        class="text-5xl md:text-7xl font-extrabold text-white mb-6 uppercase font-heading tracking-tight"
      >
        {t("extra.hero.title")}
      </h1>
      <p class="text-xl md:text-2xl text-white font-medium tracking-wide">
        {t("extra.hero.subtitle")}
      </p>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-20 bg-white">
    <div
      class="max-w-4xl mx-auto px-6 text-center text-lg md:text-xl text-gray-700 space-y-4 font-light leading-relaxed"
    >
      <p>
        {t("extra.intro.p1")}
      </p>
      <p class="font-medium text-gray-900">
        {t("extra.intro.p2")}
      </p>
    </div>
  </section>

  <!-- Col·legi 1 -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-5xl mx-auto px-6">
      <h2
        class="text-3xl font-bold text-gray-900 mb-4 uppercase text-club-granate"
      >
        {t("extra.school1.title")}
      </h2>
      <p class="text-gray-600 mb-8 max-w-2xl">
        {t("extra.school1.desc")}
      </p>

      <h3
        class="text-xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-2"
      >
        {t("extra.activities.title")}
      </h3>

      <div class="overflow-x-auto shadow-sm rounded-lg">
        <table class="w-full text-left bg-white rounded-lg overflow-hidden">
          <thead class="bg-club-granate text-white">
            <tr>
              <th class="p-4 rounded-tl-lg">{t("extra.table.activity")}</th>
              <th class="p-4">{t("extra.table.course")}</th>
              <th class="p-4">{t("extra.table.days")}</th>
              <th class="p-4 rounded-tr-lg">{t("extra.table.schedule")}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50">
              <td class="p-4 font-semibold text-gray-900">Futbol Sala</td>
              <td class="p-4 text-gray-600">Primària (1r a 6è)</td>
              <td class="p-4 text-gray-600">Dilluns i Dimecres</td>
              <td class="p-4 text-gray-600 font-mono text-sm"
                >17:00h - 18:30h</td
              >
            </tr>
            <tr class="hover:bg-gray-50 bg-gray-50/30">
              <td class="p-4 font-semibold text-gray-900">Bàsquet</td>
              <td class="p-4 text-gray-600">ESO (1r a 4t)</td>
              <td class="p-4 text-gray-600">Dimarts i Dijous</td>
              <td class="p-4 text-gray-600 font-mono text-sm"
                >18:30h - 20:00h</td
              >
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="p-4 font-semibold text-gray-900">Ball Esportiu</td>
              <td class="p-4 text-gray-600">Infantil i Primària</td>
              <td class="p-4 text-gray-600">Divendres</td>
              <td class="p-4 text-gray-600 font-mono text-sm"
                >17:00h - 18:00h</td
              >
            </tr>
            <tr class="hover:bg-gray-50 bg-gray-50/30">
              <td class="p-4 font-semibold text-gray-900">Multiesport</td>
              <td class="p-4 text-gray-600">P3 a P5</td>
              <td class="p-4 text-gray-600">Dimarts i Dijous</td>
              <td class="p-4 text-gray-600 font-mono text-sm"
                >17:00h - 18:00h</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Col·legi 2 -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-5xl mx-auto px-6">
      <h2
        class="text-3xl font-bold text-gray-900 mb-4 uppercase text-club-granate"
      >
        {t("extra.school2.title")}
      </h2>
      <p class="text-gray-600 mb-8 max-w-2xl">
        {t("extra.school2.desc")}
      </p>

      <h3
        class="text-xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-2"
      >
        {t("extra.activities.title")}
      </h3>

      <div class="overflow-x-auto shadow-sm rounded-lg">
        <table
          class="w-full text-left bg-white rounded-lg overflow-hidden border border-gray-100"
        >
          <thead class="bg-gray-800 text-white">
            <tr>
              <th class="p-4 rounded-tl-lg">{t("extra.table.activity")}</th>
              <th class="p-4">{t("extra.table.course")}</th>
              <th class="p-4">{t("extra.table.days")}</th>
              <th class="p-4 rounded-tr-lg">{t("extra.table.schedule")}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50">
              <td class="p-4 font-semibold text-gray-900">Voleibol</td>
              <td class="p-4 text-gray-600">ESO i Batxillerat</td>
              <td class="p-4 text-gray-600">Dilluns i Dimecres</td>
              <td class="p-4 text-gray-600 font-mono text-sm"
                >17:30h - 19:00h</td
              >
            </tr>
            <tr class="hover:bg-gray-50 bg-gray-50/30">
              <td class="p-4 font-semibold text-gray-900">Futbol Sala</td>
              <td class="p-4 text-gray-600">Cicle Superior Primària</td>
              <td class="p-4 text-gray-600">Dimarts i Dijous</td>
              <td class="p-4 text-gray-600 font-mono text-sm"
                >17:00h - 18:30h</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Contacte -->
  <section class="py-16 bg-club-beige/20 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8 uppercase">
        {t("extra.cta.title")}
      </h2>
      <a
        href={`/${lang}/formcontacte`}
        class="inline-block px-10 py-5 bg-club-granate text-white rounded-lg font-bold text-lg hover:bg-club-granate/90 hover:scale-105 transition-all shadow-lg"
      >
        {t("extra.cta.btn")}
      </a>
    </div>
  </section>
</Layout>
