---
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../../i18n/utils";
const t = useTranslations(lang as any);
---

<Layout title={`Fútbol Sala | Club Esportiu Acadèmia`}>
  <!-- Hero Section -->
  <section
    class="relative h-[40vh] min-h-[300px] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/futsal-hero.jpg"
        alt="Fútbol Sala Hero"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-[#b09f8b]/50"></div>
    </div>

    <div class="relative z-10 text-center px-4">
      <h1
        class="text-4xl md:text-6xl font-extrabold text-white uppercase font-heading tracking-tight"
      >
        {t("futsal.hero.title")}
      </h1>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-xl md:text-2xl text-gray-700 leading-relaxed font-light">
        {t("futsal.intro")}
      </p>
    </div>
  </section>

  <!-- Categories Accordion Section -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-5xl mx-auto px-6">
      <h2
        class="text-3xl md:text-4xl font-bold text-gray-900 mb-10 uppercase font-heading"
      >
        {t("futsal.categories.title")}
      </h2>

      <div class="space-y-4">
        <!-- GENERIC ACCORDION ITEM COMPONENT STRUCTURE -->
        <!-- Seniors -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.senior")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <h3 class="text-2xl font-bold text-club-granate mb-4">
              {t("futsal.cat.senior.1")}
            </h3>
            <div class="mb-6 rounded-lg overflow-hidden shadow-sm">
              <!-- Placeholder for Team Photo -->
              <div
                class="bg-gray-100 w-full aspect-video flex items-center justify-center text-gray-400"
              >
                <span>{t("futsal.cat.senior.photo1")}</span>
              </div>
            </div>
            <h4 class="text-lg font-semibold text-gray-800 mb-3">
              {t("futsal.cat.senior.staff")}
            </h4>
            <ol class="list-decimal pl-5 space-y-1 mb-6">
              <li>Jugador/a 1 (Posició)</li>
              <li>... (Llistat complet de jugadors/es)</li>
              <li>Entrenador Principal: Nom i Cognoms</li>
              <li>Assistent/s: Nom i Cognoms</li>
              <li>Delegat: Nom i Cognoms</li>
            </ol>

            <hr class="border-gray-200 my-6" />

            <h3 class="text-2xl font-bold text-club-granate mb-4">
              {t("futsal.cat.senior.2")}
            </h3>
            <div class="mb-6 rounded-lg overflow-hidden shadow-sm">
              <!-- Placeholder for Team Photo -->
              <div
                class="bg-gray-100 w-full aspect-video flex items-center justify-center text-gray-400"
              >
                <span>{t("futsal.cat.senior.photo2")}</span>
              </div>
            </div>
            <h4 class="text-lg font-semibold text-gray-800 mb-3">
              {t("futsal.cat.senior.staff")}
            </h4>
            <p>{t("futsal.cat.senior.desc2")}</p>
          </div>
        </details>

        <!-- Juvenils -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.juvenil")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <p>
              {t("futsal.cat.juvenil.desc")}
            </p>
          </div>
        </details>

        <!-- Cadets -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.cadet")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <p>
              {t("futsal.cat.cadet.desc")}
            </p>
          </div>
        </details>

        <!-- Infantils -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.infantil")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <p>{t("futsal.cat.infantil.desc")}</p>
          </div>
        </details>

        <!-- Alevins -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.alevi")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <p>{t("futsal.cat.alevi.desc")}</p>
          </div>
        </details>

        <!-- Benjamins -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.benjamin")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <p>
              {t("futsal.cat.benjamin.desc")}
            </p>
          </div>
        </details>

        <!-- Veterans -->
        <details
          class="group bg-white rounded-lg border border-gray-200 shadow-sm open:shadow-md transition-shadow"
        >
          <summary
            class="flex justify-between items-center w-full p-6 text-left cursor-pointer list-none text-lg font-bold text-gray-800 bg-white rounded-lg group-open:rounded-b-none group-open:bg-gray-50 hover:bg-gray-50 transition-colors"
          >
            <span>{t("futsal.cat.veterans")}</span>
            <span class="transition group-open:rotate-180">
              <svg
                fill="none"
                height="24"
                shape-rendering="geometricPrecision"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                width="24"><path d="M6 9l6 6 6-6"></path></svg
              >
            </span>
          </summary>
          <div
            class="p-6 border-t border-gray-100 text-gray-600 animate-fadeIn"
          >
            <p>{t("futsal.cat.veterans.desc")}</p>
          </div>
        </details>
      </div>

      <div class="mt-12 text-center">
        <a
          href={`/${lang}/inscripcions-2026-27`}
          class="inline-block px-10 py-4 bg-club-granate text-white rounded-lg font-bold text-xl hover:bg-club-granate/90 hover:scale-105 transition-all shadow-lg"
        >
          {t("futsal.cta")}
        </a>
      </div>
    </div>
  </section>
</Layout>
