---

<Layout title={`Futbol Sala Federat | SD Espanyol Futbol Sala`}>
  <!-- Hero Section -->
  <section
    class="relative h-[50vh] min-h-[420px] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/equips/1r-equip-masculi.jpg"
        alt="Equip Federat SD Espanyol"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#07224f]/95 via-[#005bac]/85 to-[#07224f]/95"></div>
    </div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <img
        src="/images/escudo-espanyol.png"
        alt="Escut SD Espanyol Futbol Sala"
        class="h-16 w-auto mx-auto mb-4 drop-shadow-md"
      />
      <h1
        class="text-4xl md:text-6xl font-extrabold text-white mb-4 uppercase font-heading tracking-tight"
      >
        {t("federated.hero.title")}
      </h1>
      <p class="text-lg md:text-xl text-blue-100 font-medium tracking-wide">
        {t("federated.hero.subtitle")}
      </p>
    </div>
  </section>

  <!-- Categories Filter Navigation -->
  <section class="sticky top-16 md:top-20 z-30 bg-white/95 backdrop-blur-md border-b border-gray-200 py-3 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-center gap-2 md:gap-4 overflow-x-auto text-xs md:text-sm font-bold">
      <a href="#seniors" class="px-4 py-2 rounded-full bg-blue-50 text-[#0073ce] hover:bg-[#0073ce] hover:text-white transition-colors whitespace-nowrap">
        SÈNIORS
      </a>
      <a href="#juvenils" class="px-4 py-2 rounded-full bg-blue-50 text-[#0073ce] hover:bg-[#0073ce] hover:text-white transition-colors whitespace-nowrap">
        JUVENILS
      </a>
      <a href="#infantil" class="px-4 py-2 rounded-full bg-blue-50 text-[#0073ce] hover:bg-[#0073ce] hover:text-white transition-colors whitespace-nowrap">
        INFANTIL
      </a>
      <a href="#alevi" class="px-4 py-2 rounded-full bg-blue-50 text-[#0073ce] hover:bg-[#0073ce] hover:text-white transition-colors whitespace-nowrap">
        ALEVÍ
      </a>
      <a href="#benjamins" class="px-4 py-2 rounded-full bg-blue-50 text-[#0073ce] hover:bg-[#0073ce] hover:text-white transition-colors whitespace-nowrap">
        BENJAMINS
      </a>
    </div>
  </section>

  <!-- Teams Section -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 md:px-6 space-y-20">
      {
        ["seniors", "juvenils", "infantil", "alevi", "benjamins"].map((catKey) => {
          const categoryTeams = teams.filter((t) => t.category === catKey);
          const categoryTitle = categoryTeams[0]?.categoryLabel || catKey.toUpperCase();

          return (
            <div id={catKey} class="scroll-mt-36">
              <div class="flex items-center gap-4 mb-10 pb-4 border-b-2 border-[#0073ce]/20">
                <span class="w-3 h-8 bg-[#0073ce] rounded-full"></span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight uppercase font-heading">
                  {categoryTitle}
                </h2>
              </div>

              <div class="space-y-12">
                {categoryTeams.map((team) => (
                  <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden hover:shadow-md transition-shadow">
                    <!-- Team Header -->
                    <div class="bg-gradient-to-r from-[#07224f] to-[#005bac] text-white p-6 md:p-8 flex flex-col md:flex-row justify-between md:items-center gap-4">
                      <div>
                        <span class="text-xs font-bold text-blue-200 tracking-widest uppercase block mb-1">
                          Temporada {team.season}
                        </span>
                        <h3 class="text-2xl md:text-3xl font-extrabold font-heading">
                          {team.name}
                        </h3>
                      </div>
                      <span class="inline-flex items-center gap-1.5 self-start md:self-auto bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full text-xs font-bold tracking-wider uppercase border border-white/20">
                        <span>👥</span> {team.players.length} Jugadors/es
                      </span>
                    </div>

                    <div class="p-6 md:p-8">
                      <!-- Official Team Photo -->
                      {team.image ? (
                        <div class="mb-8 rounded-xl overflow-hidden shadow-md border border-gray-100 max-h-[500px]">
                          <img
                            src={team.image}
                            alt={`Foto Oficial ${team.name}`}
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        </div>
                      ) : null}

                      <!-- Staff Tècnic -->
                      {team.staff.length > 0 && (
                        <div class="mb-8 bg-blue-50/60 p-5 rounded-xl border border-[#0073ce]/15">
                          <h4 class="text-xs font-bold text-[#0073ce] uppercase tracking-widest mb-3 flex items-center gap-2">
                            <span>📋</span> {t("federated.staff")}
                          </h4>
                          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            {team.staff.map((s) => (
                              <div class="bg-white p-3 rounded-lg border border-gray-100">
                                <span class="text-xs text-gray-400 block font-semibold">{s.role}</span>
                                <span class="text-sm font-bold text-gray-800">{s.name}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      <!-- Plantilla -->
                      <div>
                        <h4 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">
                          {t("federated.roster")}
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                          {team.players.map((player) => (
                            <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-gray-100 hover:border-[#0073ce]/30 hover:bg-white transition-colors">
                              <span class="w-8 h-8 rounded-full bg-[#0073ce] text-white flex items-center justify-center font-bold text-xs flex-shrink-0 shadow-xs">
                                {player.num}
                              </span>
                              <span class="font-medium text-gray-800 text-sm">
                                {player.name}
                              </span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }

      <!-- Bottom CTA -->
      <div class="bg-[#07224f] text-white rounded-2xl p-8 md:p-12 text-center">
        <h3 class="text-2xl md:text-3xl font-extrabold uppercase font-heading mb-4">
          {t("cta.play_full")}
        </h3>
        <p class="text-blue-200 text-sm md:text-base max-w-2xl mx-auto mb-8">
          Forma part del projecte esportiu del SD Espanyol Futbol Sala i defensa la samarreta blanc-i-blava a les categories federades.
        </p>
        <a
          href={`/${lang}/inscripcions-2026-27?tipus=federat`}
          class="inline-block px-8 py-4 bg-[#0073ce] hover:bg-[#005bac] text-white font-extrabold rounded-xl shadow-lg transition-transform hover:scale-105"
        >
          INSCRIU-TE ARA ⚽
        </a>
      </div>
    </div>
  </section>
</Layout>
