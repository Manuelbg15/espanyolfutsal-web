---
import Layout from "../../layouts/Layout.astro";
import SectionCard from "../../components/SectionCard.astro";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang as any);

// Images to be saved locally
// 1. unete-a-nosotros.png -> /images/seccions-hero.png
// 2. futbol-sala.jpg -> /images/seccion-futbol-sala.jpg
// 3. violeibol.jpg -> /images/seccion-voleibol.jpg
// 4. basquet.jpg -> /images/seccion-basquet.jpg
// 5. gimnasia.jpg -> /images/seccion-ball-esportiu.jpg

const sections = [
  {
    title: t("sections.futsal.title"),
    image: "/images/seccion-futbol-sala.jpg",
    link: `/${lang}/seccions/futbol-sala`,
    description: t("sections.futsal.desc"),
  },
  {
    title: t("sections.volleyball.title"),
    image: "/images/seccion-voleibol.jpg",
    link: "#", // No link specified in request, keeping as placeholder or anchor
    description: t("sections.volleyball.desc"),
  },
  {
    title: t("sections.basketball.title"),
    image: "/images/seccion-basquet.jpg",
    link: "#", // No link specified in request
    description: t("sections.basketball.desc"),
  },
  {
    title: t("sections.dance.title"),
    image: "/images/seccion-ball-esportiu.jpg",
    link: "#", // No link specified in request
    description: t("sections.dance.desc"),
  },
];
---

<Layout title="Seccions | Club Esportiu Acadèmia">
  <!-- Hero Section -->
  <section
    class="relative h-[50vh] min-h-[450px] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/seccions-hero.png"
        alt="Seccions Hero"
        class="w-full h-full object-cover"
      />
      <!-- CUSTOM OVERLAY COLOR: #8b7971 with opacity -->
      <div class="absolute inset-0 bg-[#8b7971]/60"></div>
    </div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1
        class="text-5xl md:text-7xl font-extrabold text-white mb-6 uppercase font-heading tracking-tight"
      >
        {t("sections.hero.title")}
      </h1>
      <p class="text-xl md:text-2xl text-white font-medium tracking-wide">
        {t("sections.hero.subtitle")}
      </p>
    </div>
  </section>

  <!-- Sections Grid -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        {
          sections.map((section) => (
            <SectionCard
              title={section.title}
              image={section.image}
              link={section.link}
              description={section.description}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gray-50 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2
        class="text-3xl md:text-4xl font-bold text-gray-900 uppercase font-heading mb-8"
      >
        {t("sections.cta.title")}
      </h2>
      <a
        href={`/${lang}/inscripcions-2026-27`}
        class="inline-block px-10 py-5 bg-club-granate text-white rounded-lg font-bold text-xl hover:bg-club-granate/90 transition-all shadow-lg transform hover:-translate-y-1"
      >
        {t("sections.cta.btn")}
      </a>
    </div>
  </section>
</Layout>
