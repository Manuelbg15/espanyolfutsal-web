---
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang as any);

const campusActivities = [
  {
    title: t("campus.christmas.title"),
    image: "/images/instalacions/pavello-jm-1.jpg",
    link: `/${lang}/formcontacte`,
    description: t("campus.christmas.desc"),
    badge: t("campus.btn.coming_soon"),
  },
  {
    title: t("campus.technification.title"),
    image: "/images/activitats/campus.jpg",
    link: `/${lang}/formcontacte`,
    description: t("campus.technification.desc"),
    badge: t("campus.btn.coming_soon"),
  },
  {
    title: t("campus.summer.title"),
    image: "/images/instalacions/pavello-xaloc-1.jpg",
    link: `/${lang}/formcontacte`,
    description: t("campus.summer.desc"),
    badge: t("campus.btn.coming_soon"),
  },
];
---

<Layout title={`Campus Esportius | SD Espanyol Futbol Sala`}>
  <!-- Hero Section -->
  <section
    class="relative h-[50vh] min-h-[420px] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/activitats/campus.jpg"
        alt="Campus Esportius SD Espanyol"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#07224f]/95 via-[#005bac]/85 to-[#07224f]/95"></div>
    </div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <img
        src="/images/escudo-espanyol.png"
        alt="Escut SD Espanyol Futbol Sala"
        class="h-16 w-auto mx-auto mb-4 drop-shadow-md"
      />
      <h1
        class="text-4xl md:text-6xl font-extrabold text-white mb-4 uppercase font-heading tracking-tight"
      >
        {t("campus.hero.title")}
      </h1>
      <p class="text-lg md:text-xl text-blue-100 font-medium tracking-wide">
        {t("campus.hero.subtitle")}
      </p>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-xl md:text-2xl text-gray-700 leading-relaxed font-light">
        {t("campus.intro")}
      </p>
    </div>
  </section>

  <!-- Campus Grid -->
  <section class="py-20 bg-slate-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          campusActivities.map((activity) => (
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col border border-gray-100">
              <div class="h-60 overflow-hidden relative group bg-gray-100">
                <img
                  src={activity.image}
                  alt={activity.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-4 right-4 bg-[#0073ce] text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md uppercase tracking-wider">
                  {activity.badge}
                </span>
              </div>
              <div class="p-8 flex flex-col flex-grow text-center">
                <h3 class="text-2xl font-bold text-gray-900 mb-3 uppercase font-heading">
                  {activity.title}
                </h3>
                <p class="text-gray-600 mb-8 leading-relaxed flex-grow text-sm">
                  {activity.description}
                </p>
                <a
                  href={activity.link}
                  class="inline-block px-6 py-3 border-2 border-[#0073ce] text-[#0073ce] hover:bg-[#0073ce] hover:text-white font-bold rounded-xl transition-all uppercase text-xs tracking-wider"
                >
                  DEMANAR INFORMACIÓ 📩
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA Contacte -->
  <section class="py-16 bg-blue-50/60 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2
        class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-6 uppercase font-heading"
      >
        {t("campus.cta.title")}
      </h2>
      <a
        href={`/${lang}/formcontacte`}
        class="inline-block px-10 py-5 bg-[#0073ce] hover:bg-[#005bac] text-white rounded-xl font-extrabold text-lg transition-all shadow-lg hover:scale-105"
      >
        {t("campus.cta.btn")}
      </a>
    </div>
  </section>
</Layout>
