---
import Layout from "../../../layouts/Layout.astro";
import NewsCard from "../../../components/NewsCard.astro";

export async function getStaticPaths() {
    return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
import { useTranslations } from "../../../i18n/utils";
const t = useTranslations(lang as any);

let posts: any[] = [];
try {
    const response = await fetch("https://cms.dragonrcnc.com/api/noticias", {
        method: "GET",
        headers: {
            "X-API-KEY":
                import.meta.env.CMS_API_KEY || process.env.CMS_API_KEY || "",
            Origin: import.meta.env.PROD
                ? "https://clubesportiuacademia.es"
                : "http://localhost:4321", // Ajustar puerto local
            Accept: "application/json",
        },
    });

    if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
    const data = await response.json();
    posts = data.map((post: any) => ({
        ...post,
        imageUrl: post.imageUrl
            ? `https://cms.dragonrcnc.com${post.imageUrl}`
            : "/images/logo-projecte.png",
    }));
} catch (error) {
    console.error("Error obteniendo noticias:", error);
}
---

<Layout title={`Actualitat | Club Esportiu Acadèmia`}>
    <!-- Hero Section -->
    <section
        class="relative h-[40vh] min-h-[400px] flex items-center justify-center overflow-hidden"
    >
        <div class="absolute inset-0 z-0">
            <img
                src="/images/actualitat-hero.png"
                alt="Actualitat Hero"
                class="w-full h-full object-cover"
            />
            <!-- OVERLAY: #797a7a with opacity -->
            <div class="absolute inset-0 bg-[#797a7a]/60"></div>
        </div>

        <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
            <h1
                class="text-5xl md:text-7xl font-extrabold text-white mb-6 uppercase font-heading tracking-tight"
            >
                {t("news.page.hero.title")}
            </h1>
            <p class="text-xl md:text-2xl text-white font-medium tracking-wide">
                {t("news.page.hero.subtitle")}
            </p>
        </div>
    </section>

    <!-- News Section -->
    <section class="py-24 bg-gray-50 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-6">
            <h2
                class="text-3xl font-bold text-gray-900 mb-12 uppercase text-club-granate"
            >
                {t("news.latest.title")}
            </h2>

            {
                posts.length > 0 && (
                    <div class="mb-16">
                        <div class="group relative bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 flex flex-col lg:flex-row">
                            <div class="lg:w-3/5 overflow-hidden">
                                <a
                                    href={`/${lang}/actualitat/${posts[0].id}`}
                                    class="block h-full"
                                >
                                    <img
                                        src={posts[0].imageUrl}
                                        alt={posts[0].title}
                                        class="w-full h-full object-cover aspect-video lg:aspect-auto transition-transform duration-700 group-hover:scale-105"
                                    />
                                </a>
                                <div class="absolute top-4 left-4">
                                    <span class="bg-club-granate text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest shadow-lg">
                                        Destacat
                                    </span>
                                </div>
                            </div>
                            <div class="lg:w-2/5 p-8 md:p-12 flex flex-col justify-center bg-white">
                                <span class="text-club-gold text-sm font-bold uppercase tracking-widest mb-4 inline-block">
                                    {new Date(
                                        posts[0].publishedAt || Date.now(),
                                    ).toLocaleDateString(
                                        lang === "ca" ? "ca-ES" : "es-ES",
                                        {
                                            day: "numeric",
                                            month: "long",
                                            year: "numeric",
                                        },
                                    )}
                                </span>
                                <h3 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 group-hover:text-club-granate transition-colors leading-tight">
                                    <a
                                        href={`/${lang}/actualitat/${posts[0].id}`}
                                    >
                                        {posts[0].title}
                                    </a>
                                </h3>
                                <p class="text-gray-600 text-lg mb-8 line-clamp-4 leading-relaxed">
                                    {posts[0].description ||
                                        "Fes clic per llegir els detalls d'aquesta notícia d'actualitat del nostre club."}
                                </p>
                                <div class="mt-auto">
                                    <a
                                        href={`/${lang}/actualitat/${posts[0].id}`}
                                        class="inline-flex items-center text-club-granate font-bold text-lg hover:text-club-gold transition-colors pb-1 border-b-2 border-club-granate/10 hover:border-club-gold"
                                    >
                                        Llegir més
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                )
            }

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                {
                    posts.length > 1 ? (
                        posts
                            .slice(1)
                            .map((post) => (
                                <NewsCard
                                    title={post.title}
                                    image={post.imageUrl}
                                    link={`/${lang}/actualitat/${post.id}`}
                                    excerpt={post.description || ""}
                                />
                            ))
                    ) : posts.length === 0 ? (
                        <p class="text-center col-span-full py-12 text-gray-500 italic">
                            {t("news.no_posts")}
                        </p>
                    ) : null
                }
            </div>
        </div>
    </section>

    <!-- Subvencions Highlight -->
    <section
        id="subvencions-destacades"
        class="py-24 bg-club-beige/20 border-t border-gray-200"
    >
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2
                class="text-3xl font-bold text-gray-900 mb-6 uppercase text-club-granate"
            >
                {t("news.grants.highlight.title")}
            </h2>
            <p class="text-xl text-gray-700 mb-10 leading-relaxed">
                {t("news.grants.highlight.desc")}
            </p>

            <a
                href="#subvencions-llistat"
                class="inline-block px-10 py-5 bg-club-granate text-white rounded-lg font-bold text-lg hover:bg-club-granate/90 hover:scale-105 transition-all shadow-lg"
            >
                {t("news.grants.highlight.btn")}
            </a>
        </div>
    </section>

    <!-- Subvencions List -->
    <section
        id="subvencions-llistat"
        class="py-24 bg-white border-t border-gray-200"
    >
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl font-bold text-gray-900 mb-4 uppercase text-club-granate"
                >
                    {t("news.grants.list.title")}
                </h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    {t("news.grants.list.desc")}
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-12">
                <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
                    <h3
                        class="text-2xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-2"
                    >
                        {t("news.grants.active.title")}
                    </h3>
                    <ul class="space-y-4">
                        <li class="flex items-start">
                            <span class="mr-2 text-club-gold">➤</span>
                            <span class="text-gray-700"
                                ><strong>{t("news.grants.item1.title")}</strong>
                                <br /><span class="text-sm text-gray-500"
                                    >{t("news.grants.item1.deadline")}</span
                                ></span
                            >
                        </li>
                        <li class="flex items-start">
                            <span class="mr-2 text-club-gold">➤</span>
                            <span class="text-gray-700"
                                ><strong>{t("news.grants.item2.title")}</strong>
                                <br /><span class="text-sm text-gray-500"
                                    >{t("news.grants.item2.deadline")}</span
                                ></span
                            >
                        </li>
                    </ul>
                </div>

                <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
                    <h3
                        class="text-2xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-2"
                    >
                        {t("news.grants.docs.title")}
                    </h3>
                    <ul class="space-y-4">
                        <li
                            class="flex items-center text-gray-700 hover:text-club-granate transition-colors cursor-pointer"
                        >
                            <span class="mr-2 text-2xl">📄</span>
                            <span>{t("news.grants.docs.guide")}</span>
                        </li>
                        <li
                            class="flex items-center text-gray-700 hover:text-club-granate transition-colors cursor-pointer"
                        >
                            <span class="mr-2 text-2xl">🔗</span>
                            <span>{t("news.grants.docs.form")}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</Layout>
