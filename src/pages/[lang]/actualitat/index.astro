---
import Layout from "../../../layouts/Layout.astro";
import NewsCard from "../../../components/NewsCard.astro";
import { getNoticias, type Lang } from "../../../lib/noticias";
import { useTranslations } from "../../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "ca" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const locale = lang === "es" ? "es-ES" : "ca-ES";

const posts = await getNoticias(lang as Lang);
const fallbackImg = "/images/escudo-espanyol.png";
const [featured, ...rest] = posts;
const fmt = (d: Date) =>
  d.toLocaleDateString(locale, { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${t("news.page.hero.title")} | SD Espanyol Futbol Sala`}>
  <section class="relative h-[40vh] min-h-[340px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/images/instalacions/pista1-azul.jpg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#07224f]/95 via-[#005bac]/85 to-[#07224f]/95"></div>
    </div>
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4 uppercase font-heading tracking-tight">
        {t("news.page.hero.title")}
      </h1>
      <p class="text-lg md:text-xl text-blue-100 font-medium">{t("news.page.hero.subtitle")}</p>
    </div>
  </section>

  <section id="noticies" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-10 uppercase font-heading">
        {t("news.latest.title")}
      </h2>

      {posts.length === 0 && (
        <p class="text-center py-12 text-gray-500 italic">{t("news.no_posts")}</p>
      )}

      {featured && (
        <article class="mb-14 bg-white rounded-2xl overflow-hidden shadow-lg flex flex-col lg:flex-row">
          <a href={`/${lang}/actualitat/${featured.slug}`} class="lg:w-3/5 block overflow-hidden">
            <img
              src={featured.image || fallbackImg}
              alt={featured.title}
              class="w-full h-full max-h-[460px] object-cover aspect-video lg:aspect-auto"
            />
          </a>
          <div class="lg:w-2/5 p-8 md:p-10 flex flex-col justify-center">
            <time class="text-[#0073ce] text-sm font-bold mb-3" datetime={featured.date.toISOString()}>
              {fmt(featured.date)}
            </time>
            <h3 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4 font-heading leading-tight">
              <a href={`/${lang}/actualitat/${featured.slug}`} class="hover:text-[#0073ce]">
                {featured.title}
              </a>
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed line-clamp-4">{featured.description}</p>
            <a
              href={`/${lang}/actualitat/${featured.slug}`}
              class="self-start text-[#0073ce] font-bold border-b-2 border-[#0073ce]/30 hover:border-[#0073ce]"
            >
              {t("news.read_more")}
            </a>
          </div>
        </article>
      )}

      {rest.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {rest.map((post) => (
            <NewsCard
              title={post.title}
              image={post.image || fallbackImg}
              link={`/${lang}/actualitat/${post.slug}`}
              excerpt={post.description}
              readMore={t("news.read_more")}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <section id="subvencions" class="py-20 bg-white border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4 uppercase font-heading">
        {t("news.grants.title")}
      </h2>
      <div class="w-16 h-1 bg-[#0073ce] mx-auto mb-10 rounded-full"></div>
      <div class="bg-[#e8f4fd] border border-[#0073ce]/20 rounded-2xl p-8 md:p-10 text-left md:flex md:items-center md:gap-8">
        <div class="flex-1">
          <h3 class="text-xl md:text-2xl font-bold text-[#07224f] font-heading mb-2">
            {t("news.grants.item.title")}
          </h3>
          <p class="text-gray-700 leading-relaxed">{t("news.grants.item.desc")}</p>
        </div>
        <a
          href="https://www.plaesportescolarbcn.cat/es/subvenciones_302069"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 md:mt-0 inline-block shrink-0 px-6 py-3.5 bg-[#0073ce] hover:bg-[#005696] text-white rounded-xl font-bold transition-colors"
        >
          {t("news.grants.item.btn")}
        </a>
      </div>
    </div>
  </section>
</Layout>
