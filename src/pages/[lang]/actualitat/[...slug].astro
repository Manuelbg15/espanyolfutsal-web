---
// src/pages/actualitat/[...slug].astro
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
    let posts: any[] = [];
    try {
        const response = await fetch(
            "https://cms.dragonrcnc.com/api/noticias",
            {
                method: "GET",
                headers: {
                    "X-API-KEY":
                        import.meta.env.CMS_API_KEY ||
                        process.env.CMS_API_KEY ||
                        "",
                    Origin: import.meta.env.PROD
                        ? "https://clubesportiuacademia.es"
                        : "http://localhost:4321", // Ajustar puerto local
                    Accept: "application/json",
                },
            },
        );

        if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
        posts = await response.json();
    } catch (error) {
        console.error("Error obteniendo noticias:", error);
    }

    const paths: any[] = [];
    const languages = ["ca", "es"];

    languages.forEach((lang) => {
        posts.forEach((post: any) => {
            const imageUrl = post.imageUrl
                ? `https://cms.dragonrcnc.com${post.imageUrl}`
                : null;
            paths.push({
                params: { lang, slug: String(post.id) },
                props: { ...post, imageUrl },
            });
        });
    });

    return paths;
}

const { lang } = Astro.params;
const post = Astro.props;
---

<Layout title={`${post.title} | Club Esportiu Acadèmia`}>
    <section class="max-w-4xl mx-auto px-6 py-12 md:py-20">
        <article>
            {
                post.imageUrl && (
                    <img
                        width={1020}
                        height={510}
                        src={post.imageUrl}
                        alt={post.title}
                        class="w-full h-auto object-cover rounded-xl shadow-lg mb-8"
                    />
                )
            }
            <div
                class="prose prose-lg max-w-none prose-img:rounded-xl prose-a:text-blue-600 prose-headings:font-bold prose-headings:text-club-granate"
            >
                <div class="mb-8 border-b border-gray-100 pb-4">
                    <div
                        class="text-sm text-gray-500 uppercase font-bold tracking-wider mb-2"
                    >
                        {
                            new Date(
                                post.pubDate || post.createdAt || Date.now(),
                            ).toLocaleDateString("ca-ES", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })
                        }
                    </div>
                    <h1
                        class="text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight"
                    >
                        {post.title}
                    </h1>
                    <p
                        class="text-xl text-gray-600 mt-4 leading-relaxed font-light"
                    >
                        {post.description}
                    </p>
                </div>

                <div set:html={post.content} />
            </div>

            <div class="mt-12 pt-8 border-t border-gray-200">
                <a
                    href={`/${lang}/actualitat`}
                    class="inline-flex items-center text-club-granate font-bold hover:underline"
                >
                    ← Tornar a l'Actualitat
                </a>
            </div>
        </article>
    </section>
</Layout>
