---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
import LanguagePicker from "./LanguagePicker.astro";
const t = useTranslations(lang as any);
import { STORE_URL } from "../data/links";
const storeHref = STORE_URL || `/${lang}/formcontacte`;
const storeExternal = STORE_URL !== "";
---

<header
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm"
>
  <div
    class="max-w-[96rem] mx-auto px-4 sm:px-6 py-2.5 flex justify-between items-center gap-4"
  >
    <!-- LOGO (Left) -->
    <a
      href={`/${lang}/`}
      class="hover:scale-105 transition-transform flex items-center gap-3 flex-shrink-0"
    >
      <img
        src="/images/escudo-espanyol.png"
        alt="SD Espanyol Futbol Sala"
        class="h-12 md:h-14 w-auto object-contain drop-shadow-sm"
      />
      <div class="hidden sm:flex flex-col text-left">
        <span class="font-extrabold text-[#0073ce] text-base md:text-lg leading-tight tracking-wider uppercase font-heading">
          SD ESPANYOL
        </span>
        <span class="font-bold text-gray-800 text-xs md:text-sm tracking-widest uppercase">
          FUTBOL SALA
        </span>
      </div>
    </a>

    <!-- DESKTOP NAV LINKS (Center) -->
    <nav class="hidden 2xl:flex space-x-5 items-center justify-center flex-grow">

      <!-- Dropdown El Club -->
      <div class="relative group">
        <a
          href={`/${lang}/el-club`}
          class="flex items-center whitespace-nowrap text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors py-2"
        >
          {t("nav.club")}
          <svg
            class="w-3.5 h-3.5 ml-1 transform group-hover:rotate-180 transition-transform text-gray-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </a>
        <div
          class="absolute top-full left-0 mt-1 w-60 bg-white border border-gray-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:-translate-y-1 p-2"
        >
          <a
            href={`/${lang}/el-club#entitat`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.entity")}</a
          >
          <a
            href={`/${lang}/el-club#projecte`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.project")}</a
          >
          <a
            href={`/${lang}/el-club#objectius`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.objectives")}</a
          >
          <a
            href={`/${lang}/el-club#valors`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.values")}</a
          >
          <a
            href={`/${lang}/el-club#normativa`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.rules")}</a
          >
          <a
            href={`/${lang}/el-club#instal-lacions`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.facilities")}</a
          >
          <a
            href={`/${lang}/el-club#patrocinadors`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.sponsors")}</a
          >
          <a
            href={`/${lang}/el-club#enllacs-interes`}
            class="block px-3 py-2 text-gray-700 hover:text-[#0073ce] hover:bg-blue-50/50 rounded-lg text-sm font-medium transition-colors"
            >{t("nav.club.links")}</a
          >
        </div>
      </div>

      <!-- Futbol Sala Federat -->
      <a
        href={`/${lang}/seccions/futbol-sala`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors whitespace-nowrap"
        >{t("nav.federated")}</a
      >

      <!-- Futbol Sala Escolar -->
      <a
        href={`/${lang}/extraescolars`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors whitespace-nowrap"
        >{t("nav.school")}</a
      >

      <!-- Simpatitzant -->
      <a
        href={`/${lang}/simpatitzant`}
        class="text-[#0073ce] hover:text-[#005bac] font-bold text-sm transition-colors whitespace-nowrap flex items-center gap-1"
      >
        <span>💙</span> {t("nav.simpatitzant")}
      </a>

      <!-- Campus -->
      <a
        href={`/${lang}/campus-esportius`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors"
        >{t("nav.campus")}</a
      >

      <!-- Actualitat -->
      <a
        href={`/${lang}/actualitat`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors"
        >{t("nav.news")}</a
      >

      <!-- Store -->
      <a
        href={storeHref}
        target={storeExternal ? "_blank" : undefined}
        rel={storeExternal ? "noopener noreferrer" : undefined}
        class="text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors whitespace-nowrap"
        >{t("nav.store")}</a
      >

      <!-- Contacte -->
      <a
        href={`/${lang}/formcontacte`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold text-sm transition-colors"
        >{t("nav.contact")}</a
      >
    </nav>

    <!-- RIGHT ACTIONS (Language + CTA) -->
    <div class="hidden 2xl:flex items-center space-x-3 flex-shrink-0">
      <!-- Barcelona Futsal Cup -->
      <a
        href="https://barcelonafutsalcup.es/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-gray-800 font-bold text-sm border-2 border-[#0073ce]/20 px-3 py-1.5 rounded-lg hover:bg-[#0073ce] hover:text-white hover:border-transparent transition-colors whitespace-nowrap"
      >
        <span>🏆</span>
        <span>{t("nav.cup")}</span>
      </a>

      <!-- Language Picker -->
      <LanguagePicker />

      <!-- Socials -->
      <a
        href="https://www.instagram.com/sdespanyol_futsal"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-gray-500 hover:text-[#0073ce] transition-colors"
        aria-label="Instagram"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <!-- CTA VOLS JUGAR AMB NOSALTRES (Always visible) -->
      <a
        href={`/${lang}/inscripcions-2026-27`}
        class="bg-[#0073ce] hover:bg-[#005bac] text-white px-4 py-2 rounded-full font-extrabold text-xs tracking-wider shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 whitespace-nowrap flex items-center gap-1.5"
      >
        <span>⚽</span>
        <span>{t("cta.play")}</span>
      </a>
    </div>

    <!-- Mobile Menu Button & Small CTA -->
    <div class="2xl:hidden flex items-center gap-2">
      <a
        href={`/${lang}/inscripcions-2026-27`}
        class="bg-[#0073ce] hover:bg-[#005bac] text-white px-3 py-1.5 rounded-full font-bold text-xs tracking-wider shadow transition-all whitespace-nowrap"
      >
        {t("cta.play")}
      </a>

      <button
        class="p-2 text-gray-800 hover:text-[#0073ce] focus:outline-none rounded-lg"
        id="menu-btn"
        aria-label="Menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    class="2xl:hidden hidden bg-white/95 backdrop-blur-md border-b border-gray-200"
    id="mobile-menu"
  >
    <div class="flex flex-col space-y-3 px-6 py-4 max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-2 border-b border-gray-100">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Idioma</span>
        <LanguagePicker />
      </div>

      <a
        href={`/${lang}/`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.home")}</a
      >

      <!-- Collapsible El Club -->
      <details class="group">
        <summary
          class="flex justify-between items-center w-full py-1.5 text-gray-800 font-semibold cursor-pointer list-none hover:text-[#0073ce] transition-colors"
        >
          <span>{t("nav.club")}</span>
          <svg
            class="w-4 h-4 transform group-open:rotate-180 transition-transform text-[#0073ce]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </summary>
        <div class="space-y-1.5 pl-4 border-l-2 border-[#0073ce]/30 mt-1 mb-2">
          <a
            href={`/${lang}/el-club#entitat`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.entity")}</a
          >
          <a
            href={`/${lang}/el-club#projecte`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.project")}</a
          >
          <a
            href={`/${lang}/el-club#objectius`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.objectives")}</a
          >
          <a
            href={`/${lang}/el-club#valors`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.values")}</a
          >
          <a
            href={`/${lang}/el-club#normativa`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.rules")}</a
          >
          <a
            href={`/${lang}/el-club#instal-lacions`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.facilities")}</a
          >
          <a
            href={`/${lang}/el-club#patrocinadors`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.sponsors")}</a
          >
          <a
            href={`/${lang}/el-club#enllacs-interes`}
            class="block text-gray-600 hover:text-[#0073ce] text-sm py-1"
            >{t("nav.club.links")}</a
          >
        </div>
      </details>

      <a
        href={`/${lang}/seccions/futbol-sala`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.federated")}</a
      >

      <a
        href={`/${lang}/extraescolars`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.school")}</a
      >

      <a
        href={`/${lang}/simpatitzant`}
        class="text-[#0073ce] font-bold py-1.5 flex items-center gap-1"
        ><span>💙</span> {t("nav.simpatitzant")}</a
      >

      <a
        href={`/${lang}/campus-esportius`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.campus")}</a
      >

      <a
        href={`/${lang}/actualitat`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.news")}</a
      >

      <a
        href={storeHref}
        target={storeExternal ? "_blank" : undefined}
        rel={storeExternal ? "noopener noreferrer" : undefined}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.store")}</a
      >

      <a
        href={`/${lang}/formcontacte`}
        class="text-gray-800 hover:text-[#0073ce] font-semibold py-1.5"
        >{t("nav.contact")}</a
      >

      <div class="flex flex-col gap-3 mt-4 pt-4 border-t border-gray-100">
        <a
          href="https://barcelonafutsalcup.es/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex justify-center items-center gap-2 text-gray-800 font-bold border-2 border-[#0073ce]/20 px-4 py-3 rounded-xl hover:bg-[#0073ce] hover:text-white transition-colors"
        >
          <span class="text-lg">🏆</span> {t("nav.cup")}
        </a>

        <a
          href={`/${lang}/inscripcions-2026-27`}
          class="bg-[#0073ce] hover:bg-[#005bac] text-white px-5 py-3 rounded-xl font-extrabold text-center shadow"
        >
          {t("cta.play_full")}
        </a>

        <div class="flex justify-center gap-6 mt-2 text-gray-500">
          <a
            href="https://www.instagram.com/sdespanyol_futsal"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#0073ce] transition-colors"
          >
            <span class="sr-only">Instagram</span>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@SDEspanyolFutsal"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#0073ce] transition-colors"
          >
            <span class="sr-only">YouTube</span>
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 01-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 01-1.768-1.768C2 15.255 2 12 2 12s0-3.254.419-4.813a2.503 2.503 0 011.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418zM15.194 12 10 15V9l5.194 3z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  }
</script>
