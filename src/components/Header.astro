---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
import LanguagePicker from "./LanguagePicker.astro";
const t = useTranslations(lang as any);
---

<header
  class="fixed w-full z-50 transition-all duration-300 bg-club-beige/95 backdrop-blur-md border-b border-club-gold/20 shadow-sm"
>
  <div
    class="max-w-7xl mx-auto px-6 py-3 flex justify-between items-center gap-4"
  >
    <!-- LOGO (Left) -->
    <a
      href={`/${lang}/`}
      class="hover:scale-105 transition-transform flex-shrink-0"
    >
      <img
        src="/images/logo-projecte.png"
        alt="Club Esportiu Acadèmia"
        class="h-14 w-auto drop-shadow-sm"
      />
    </a>

    <!-- DESKTOP NAV LINKS (Center) -->
    <nav class="hidden xl:flex space-x-6 items-center justify-center flex-grow">
      <a
        href={`/${lang}/`}
        class="text-gray-800 hover:text-club-granate font-medium transition-colors"
        >{t("nav.home")}</a
      >

      <!-- Dropdown El Club -->
      <div class="relative group">
        <a
          href={`/${lang}/el-club`}
          class="flex items-center text-gray-800 hover:text-club-granate font-medium transition-colors focus:outline-none"
        >
          {t("nav.club")}
          <svg
            class="w-4 h-4 ml-1 transform group-hover:rotate-180 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </a>
        <div
          class="absolute top-full left-0 mt-2 w-56 bg-white border border-gray-100 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:-translate-y-1"
        >
          <div class="py-2">
            <a
              href={`/${lang}/el-club#entitat`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.entity")}</a
            >
            <a
              href={`/${lang}/el-club#projecte`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.project")}</a
            >
            <a
              href={`/${lang}/el-club#objectius`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.objectives")}</a
            >
            <a
              href={`/${lang}/el-club#valors`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.values")}</a
            >
            <a
              href={`/${lang}/el-club#normativa`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.rules")}</a
            >
            <a
              href={`/${lang}/el-club#instal-lacions`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.facilities")}</a
            >
            <a
              href={`/${lang}/el-club#patrocinadors-seccio`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.club.sponsors")}</a
            >
          </div>
        </div>
      </div>

      <!-- Dropdown Seccions -->
      <div class="relative group">
        <a
          href={`/${lang}/seccions`}
          class="flex items-center text-gray-800 hover:text-club-granate font-medium transition-colors focus:outline-none"
        >
          {t("nav.sections")}
          <svg
            class="w-4 h-4 ml-1 transform group-hover:rotate-180 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </a>
        <div
          class="absolute top-full left-0 mt-2 w-48 bg-white border border-gray-100 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:-translate-y-1"
        >
          <div class="py-2">
            <a
              href={`/${lang}/seccions`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.sections.federated")}</a
            >
            <a
              href={`/${lang}/extraescolars`}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-club-granate hover:text-white transition-colors"
              >{t("nav.sections.extracurricular")}</a
            >
          </div>
        </div>
      </div>

      <a
        href={`/${lang}/campus-esportius`}
        class="text-gray-800 hover:text-club-granate font-medium transition-colors"
        >{t("nav.campus")}</a
      >
      <a
        href={`/${lang}/actualitat`}
        class="text-gray-800 hover:text-club-granate font-medium transition-colors"
        >{t("nav.news")}</a
      >
      <a
        href={`/${lang}/formcontacte`}
        class="text-gray-800 hover:text-club-granate font-medium transition-colors"
        >{t("nav.contact")}</a
      >
    </nav>

    <!-- DESKTOP ACTIONS (Right) -->
    <div class="hidden xl:flex items-center gap-4 flex-shrink-0">
      <LanguagePicker />

      <!-- Social Icons -->
      <div class="flex items-center gap-3 border-r border-gray-300 pr-4">
        <a
          href="https://www.instagram.com/ce.academia"
          target="_blank"
          class="text-gray-600 hover:text-club-granate transition-colors"
          title="Instagram"
        >
          <!-- Feather Icons: Instagram -->
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a
          href="https://www.youtube.com/@ce.academia"
          target="_blank"
          class="text-gray-600 hover:text-club-granate transition-colors"
          title="YouTube"
        >
          <!-- Feather Icons: YouTube -->
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path
              d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"
            ></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"
            ></polygon>
          </svg>
        </a>
      </div>

      <a
        href="https://barcelonafutsalcup.es/"
        target="_blank"
        class="flex items-center gap-2 text-gray-800 hover:text-club-granate font-bold transition-colors border-2 border-club-granate/10 px-4 py-2 rounded-lg hover:bg-club-granate hover:text-white hover:border-transparent whitespace-nowrap"
      >
        <span class="text-lg">🏆</span>
        {t("cta.futsal_cup")}
      </a>

      <a
        href={`/${lang}/inscripcions-2026-27`}
        class="bg-club-granate text-white px-5 py-2 rounded-full font-bold text-sm hover:bg-club-granate/90 shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 whitespace-nowrap"
      >
        {t("cta.play")}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button class="xl:hidden text-gray-800 focus:outline-none" id="menu-btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    class="xl:hidden hidden bg-white/90 backdrop-blur-md absolute w-full border-b border-gray-200"
    id="mobile-menu"
  >
    <div class="flex flex-col space-y-4 px-6 py-4 max-h-[80vh] overflow-y-auto">
      <div class="flex justify-end mb-2">
        <LanguagePicker />
      </div>
      <a
        href={`/${lang}/`}
        class="text-gray-800 hover:text-club-granate font-medium"
        >{t("nav.home")}</a
      >

      <!-- Collapsible El Club -->
      <details class="group">
        <summary
          class="flex justify-between items-center w-full py-2 text-gray-800 font-medium cursor-pointer list-none hover:text-club-granate transition-colors"
        >
          <span>{t("nav.club")}</span>
          <svg
            class="w-4 h-4 transform group-open:rotate-180 transition-transform text-club-granate"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </summary>
        <div class="space-y-2 pl-4 border-l-2 border-club-granate/20 mt-1 mb-2">
          <a
            href={`/${lang}/el-club#entitat`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.entity")}</a
          >
          <a
            href={`/${lang}/el-club#projecte`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.project")}</a
          >
          <a
            href={`/${lang}/el-club#objectius`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.objectives")}</a
          >
          <a
            href={`/${lang}/el-club#valors`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.values")}</a
          >
          <a
            href={`/${lang}/el-club#normativa`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.rules")}</a
          >
          <a
            href={`/${lang}/el-club#instal-lacions`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.facilities")}</a
          >
          <a
            href={`/${lang}/el-club#patrocinadors-seccio`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.club.sponsors")}</a
          >
        </div>
      </details>

      <!-- Collapsible Seccions -->
      <details class="group">
        <summary
          class="flex justify-between items-center w-full py-2 text-gray-800 font-medium cursor-pointer list-none hover:text-club-granate transition-colors"
        >
          <span>{t("nav.sections")}</span>
          <svg
            class="w-4 h-4 transform group-open:rotate-180 transition-transform text-club-granate"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </summary>
        <div class="space-y-2 pl-4 border-l-2 border-club-granate/20 mt-1 mb-2">
          <a
            href={`/${lang}/seccions`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.sections.federated")}</a
          >
          <a
            href={`/${lang}/extraescolars`}
            class="block text-gray-600 hover:text-club-granate text-sm py-1"
            >{t("nav.sections.extracurricular")}</a
          >
        </div>
      </details>

      <a
        href={`/${lang}/actualitat`}
        class="text-gray-800 hover:text-club-granate font-medium"
        >{t("nav.news")}</a
      >
      <a
        href={`/${lang}/campus-esportius`}
        class="text-gray-800 hover:text-club-granate font-medium"
        >{t("nav.campus")}</a
      >

      <div class="flex flex-col gap-3 mt-4 pt-4 border-t border-gray-100">
        <a
          href={`/${lang}/inscripcions-2026-27`}
          class="bg-club-granate text-white px-5 py-3 rounded-lg font-bold text-center shadow-sm"
        >
          {t("cta.play_full")}
        </a>

        <a
          href="https://barcelonafutsalcup.es/"
          target="_blank"
          class="flex justify-center items-center gap-2 text-gray-800 font-bold border-2 border-club-granate/10 px-4 py-3 rounded-lg"
        >
          <span class="text-lg">🏆</span>
          {t("cta.futsal_cup")}
        </a>

        <div class="flex justify-center gap-6 mt-2">
          <a
            href="https://www.instagram.com/ce.academia"
            target="_blank"
            class="text-gray-500 hover:text-club-granate"
          >
            <span class="sr-only">Instagram</span>
            <!-- Mobile Feather Icon -->
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@ce.academia"
            target="_blank"
            class="text-gray-500 hover:text-club-granate"
          >
            <span class="sr-only">YouTube</span>
            <!-- Mobile Feather Icon -->
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <path
                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"
              ></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"
              ></polygon>
            </svg>
          </a>
        </div>

        <a
          href={`/${lang}/formcontacte`}
          class="text-gray-800 hover:text-club-granate font-medium text-center mt-2"
          >{t("nav.contact")}</a
        >
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  }
</script>
