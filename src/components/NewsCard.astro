---
interface Props {
  title: string;
  image: string;
  link: string;
  excerpt: string;
  readMore?: string;
}
const { title, image, link, excerpt, readMore = "Llegir més" } = Astro.props;
---

<article class="flex flex-col h-full bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
  <a href={link} class="block aspect-video overflow-hidden">
    <img src={image} alt={title} loading="lazy" class="w-full h-full object-cover" />
  </a>
  <div class="p-6 flex flex-col flex-grow">
    <h3 class="text-xl font-bold mb-3 text-gray-900 line-clamp-2 font-heading">
      <a href={link} class="hover:text-[#0073ce] transition-colors">{title}</a>
    </h3>
    <p class="text-gray-600 mb-4 line-clamp-3 flex-grow text-sm">{excerpt}</p>
    <a href={link} class="text-[#0073ce] font-semibold text-sm hover:underline mt-auto">{readMore}</a>
  </div>
</article>
