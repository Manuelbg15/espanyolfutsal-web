---
interface Props {
  title: string;
  image: string;
  link: string;
  description: string;
}

const { title, image, link, description } = Astro.props;
---

<div class="flex flex-col items-start gap-4">
  <div class="w-full aspect-[4/3] overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300">
    <a href={link} class="block h-full w-full group">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </a>
  </div>
  
  <h3 class="text-xl font-bold font-heading text-gray-900 mt-2">
    <a href={link} class="hover:text-club-granate transition-colors">
      {title}
    </a>
  </h3>
  
  <p class="text-gray-600 leading-relaxed text-sm">
    {description}
  </p>
</div>
