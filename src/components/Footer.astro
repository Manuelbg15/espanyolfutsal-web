---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
import { STORE_URL } from "../data/links";
const storeHref = STORE_URL || `/${lang}/formcontacte`;
---

<footer class="bg-[#07224f] text-white pt-16 pb-12 border-t-4 border-[#0073ce]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Columna 1: Info Club -->
      <div class="space-y-4">
        <a href={`/${lang}/`} class="inline-flex items-center gap-3">
          <img
            src="/images/escudo-espanyol.png"
            alt="SD Espanyol Futbol Sala"
            class="h-16 w-auto drop-shadow-md"
          />
          <div>
            <h3 class="font-extrabold text-white text-lg tracking-wider font-heading leading-tight">
              SD ESPANYOL
            </h3>
            <p class="text-xs text-[#00a3e0] font-bold tracking-widest uppercase">
              FUTBOL SALA
            </p>
          </div>
        </a>
        <p class="text-sm italic font-medium text-blue-200">
          {t("footer.slogan")}
        </p>
        <p class="text-xs text-gray-300 leading-relaxed">
          {t("footer.description")}
        </p>
        
        <div class="flex space-x-3 pt-2">
          <a
            href="https://www.instagram.com/sdespanyol_futsal"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#0073ce] text-white transition-all transform hover:-translate-y-1"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@SDEspanyolFutsal"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#0073ce] text-white transition-all transform hover:-translate-y-1"
            aria-label="YouTube"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 01-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 01-1.768-1.768C2 15.255 2 12 2 12s0-3.254.419-4.813a2.503 2.503 0 011.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418zM15.194 12 10 15V9l5.194 3z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Enllaços Web -->
      <div>
        <h4 class="text-base font-bold mb-5 text-[#00a3e0] uppercase tracking-wider font-heading">
          {t("footer.sitemap")}
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={`/${lang}/`} class="text-gray-300 hover:text-white transition-colors">{t("nav.home")}</a>
          </li>
          <li>
            <a href={`/${lang}/el-club`} class="text-gray-300 hover:text-white transition-colors">{t("nav.club")}</a>
          </li>
          <li>
            <a href={`/${lang}/seccions/futbol-sala`} class="text-gray-300 hover:text-white transition-colors">{t("nav.federated")}</a>
          </li>
          <li>
            <a href={`/${lang}/extraescolars`} class="text-gray-300 hover:text-white transition-colors">{t("nav.school")}</a>
          </li>
          <li>
            <a href={`/${lang}/simpatitzant`} class="text-blue-300 hover:text-white font-medium transition-colors">💙 {t("nav.simpatitzant")}</a>
          </li>
          <li>
            <a href={`/${lang}/campus-esportius`} class="text-gray-300 hover:text-white transition-colors">{t("nav.campus")}</a>
          </li>
          <li>
            <a href={`/${lang}/actualitat`} class="text-gray-300 hover:text-white transition-colors">{t("nav.news")}</a>
          </li>
          <li>
            <a href={`/${lang}/formcontacte`} class="text-gray-300 hover:text-white transition-colors">{t("nav.contact")}</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Activitats & Inscripcions -->
      <div>
        <h4 class="text-base font-bold mb-5 text-[#00a3e0] uppercase tracking-wider font-heading">
          {t("footer.activities")}
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={`/${lang}/seccions/futbol-sala`} class="text-gray-300 hover:text-white transition-colors">Equips Sèniors</a>
          </li>
          <li>
            <a href={`/${lang}/seccions/futbol-sala#juvenils`} class="text-gray-300 hover:text-white transition-colors">Equips Juvenils</a>
          </li>
          <li>
            <a href={`/${lang}/seccions/futbol-sala#infantil`} class="text-gray-300 hover:text-white transition-colors">Infantil, Aleví i Benjamins</a>
          </li>
          <li>
            <a href={`/${lang}/extraescolars`} class="text-gray-300 hover:text-white transition-colors">Escolares en Col·legis</a>
          </li>
          <li>
            <a href={`/${lang}/campus-esportius`} class="text-gray-300 hover:text-white transition-colors">Campus i Tecnificacions</a>
          </li>
          <li>
            <a href={storeHref} class="text-gray-300 hover:text-white transition-colors">{t("footer.act.store")}</a>
          </li>
          <li class="pt-2">
            <a
              href={`/${lang}/inscripcions-2026-27`}
              class="inline-block px-4 py-2 bg-[#0073ce] hover:bg-white hover:text-[#0073ce] text-white font-bold rounded-lg text-xs uppercase tracking-wider transition-colors shadow"
            >
              ⚽ {t("cta.play_full")}
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacte Oficial -->
      <div>
        <h4 class="text-base font-bold mb-5 text-[#00a3e0] uppercase tracking-wider font-heading">
          {t("footer.contact")}
        </h4>
        <ul class="space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-2.5">
            <span class="text-lg text-[#00a3e0]">📍</span>
            <span>
              <strong>SD ESPANYOL FUTBOL SALA</strong><br />
              Carrer Pau Claris, 176, 1º 1ª<br />
              08037 – Barcelona
            </span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-lg text-[#00a3e0]">📞</span>
            <a href="tel:+34640066023" class="hover:text-white transition-colors">+34 640 066 023</a>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-lg text-[#00a3e0]">✉️</span>
            <a href="mailto:info@espanyolfutsal.es" class="hover:text-white transition-colors">info@espanyolfutsal.es</a>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-lg text-[#00a3e0]">🌐</span>
            <a href="https://www.espanyolfutsal.es" class="hover:text-white transition-colors">www.espanyolfutsal.es</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright & Legal -->
    <div
      class="border-t border-blue-900/60 pt-6 mt-8 flex flex-col md:flex-row justify-between items-center text-gray-400 text-xs"
    >
      <p>
        &copy; 2026 SD Espanyol Futbol Sala. {t("footer.rights")}
      </p>
      <div class="flex space-x-6 mt-3 md:mt-0">
        <a href={`/${lang}/avis-legal`} class="hover:text-[#00a3e0] transition-colors">{t("footer.legal")}</a>
        <a href={`/${lang}/politica-privacitat`} class="hover:text-[#00a3e0] transition-colors">{t("footer.privacy")}</a>
        <a href={`/${lang}/politica-cookies`} class="hover:text-[#00a3e0] transition-colors">{t("footer.cookies")}</a>
      </div>
    </div>
  </div>
</footer>
